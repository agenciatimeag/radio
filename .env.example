# Meta Pixel ID — público, carregado no navegador. Vite só expõe ao
# frontend variáveis prefixadas com VITE_.
VITE_META_PIXEL_ID=

# --- Só no servidor (Vercel → Project Settings → Environment Variables). ---
# NUNCA prefixar essas com VITE_ — isso as exporia no bundle do navegador.

# Pixel/Dataset ID usado pela Conversions API (normalmente o mesmo valor do
# VITE_META_PIXEL_ID acima).
META_DATASET_ID=

# Access Token da Conversions API vinculado ao Pixel/Dataset acima.
META_CAPI_ACCESS_TOKEN=

# Test Event Code do Gerenciador de Eventos — só durante os testes,
# remover depois.
META_TEST_EVENT_CODE=
